<?xml version="1.0" encoding="utf-8"?>
<!-- Shown after the system splash and until the WebView renders its first frame,
     so cold start never falls back to a plain white window. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/boot_bg" />
    <item
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/boot_mark"
        android:gravity="center" />
</layer-list>
